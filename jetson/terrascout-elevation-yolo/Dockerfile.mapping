FROM jetson-jazzy-cupy:test

ENV DEBIAN_FRONTEND=noninteractive

# ROS 2 build tools and core elevation-mapping dependencies.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        python3-colcon-common-extensions \
        python3-rosdep \
        python3-scipy \
        python3-opencv \
        python3-shapely \
        python3-ruamel.yaml \
        ros-jazzy-ament-cmake-python \
        ros-jazzy-cv-bridge \
        ros-jazzy-grid-map-msgs \
        ros-jazzy-tf-transformations \
        ros-jazzy-rosbag2-py && \
    rm -rf /var/lib/apt/lists/*

# Pin NumPy to the version compatible with ROS 2 / SciPy.
# Pin transformations to avoid its newer NumPy 2.x requirement.
RUN /opt/venv/bin/python3 -m pip install --no-cache-dir \
    "numpy==1.26.4" \
    "transformations==2024.5.24" \
    simple-parsing \
    pybase64

# ros2-numpy requires an older NumPy version.
# Install without dependencies to preserve our compatible NumPy.
RUN /opt/venv/bin/python3 -m pip install --no-cache-dir \
    --no-deps \
    ros2-numpy==0.0.5

# ROS 2 Zenoh middleware for communication with TerraScout.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-jazzy-rmw-zenoh-cpp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/ros2_ws

CMD ["bash"]
