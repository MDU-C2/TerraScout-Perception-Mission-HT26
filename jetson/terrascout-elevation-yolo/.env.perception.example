# Change per deployment, as you already do with your existing launcher.
ROS_DOMAIN_ID=133
PC_ZENOH_HOST=10.132.135.87
PC_ZENOH_PORT=7447

# Simulation camera. For the physical robot, point to an uncompressed sensor_msgs/Image topic.
YOLO_INPUT_TOPIC=/terrascout1/oakd/rgb/image_raw
YOLO_OUTPUT_TOPIC=/terrascout1/oakd/detections_2d
YOLO_ANNOTATED_TOPIC=/terrascout1/oakd/detections_image

# YOLO inference
YOLO_IMGSZ=1280
# FPS = 0.0 means no fps limit
YOLO_TARGET_FPS=0.0

# Updated perception parameters
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_MAX_ASPECT_RATIO_H_W=1.5
YOLO_IOU_THRESHOLD=0.45

# Visualization
YOLO_PUBLISH_ANNOTATED=true

# Disable detection file logging
YOLO_ENABLE_FILE_LOGGING=false
