<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="@WORLD_NAME@">
    <physics name="dart" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>@DATUM_LAT@</latitude_deg>
      <longitude_deg>@DATUM_LON@</longitude_deg>
      <elevation>@ELEVATION@</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <shadows>1</shadows>
      <grid>false</grid>
      <ambient>0.3 0.35 0.3 1</ambient>
      <background>0.5 0.6 0.7 1</background>
      <sky></sky>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>1</cast_shadows>
      <intensity>1.0</intensity>
      <direction>-0.3 0.2 -0.9</direction>
      <diffuse>1.0 0.95 0.85 1</diffuse>
      <specular>0.4 0.4 0.35 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.15 1</ambient>
            <diffuse>0.35 0.3 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!-- TRACKING TEST v2: 6 signs, 2 walls, 2 trees. -->
    <!-- Ground is 40x40 m. Robot starts at (0,0) facing +X. -->
    <!-- Path checkpoint poses in tracking_test_waypoints.csv (NOT an auto navigation script). -->
    <!-- A: distance; B: two close signs on opposite wall sides; C: one sign seen from two angles. -->
    <!-- All sign poses use the sign MODEL origin, not the center of the visible octagon. -->

    <!-- A: near, 5.6 m from start -->
    <include><name>stop_sign_range_near</name><uri>model://stop_sign</uri><pose>5 -2.5 0 0 0 -1.570796</pose></include>
    <!-- A: medium, 10.1 m from start -->
    <include><name>stop_sign_range_mid</name><uri>model://stop_sign</uri><pose>10 -1.5 0 0 0 -1.570796</pose></include>
    <!-- A: far, 15.1 m from start -->
    <include><name>stop_sign_range_far</name><uri>model://stop_sign</uri><pose>15 -2 0 0 0 -1.570796</pose></include>
    <!-- B: south side of wall (visible from south) -->
    <include><name>stop_sign_wall_south</name><uri>model://stop_sign</uri><pose>11 7 0 0 0 0.000000</pose></include>
    <!-- B: north side of wall (visible from north) -->
    <include><name>stop_sign_wall_north</name><uri>model://stop_sign</uri><pose>11 9 0 0 0 3.141593</pose></include>
    <!-- C: seen from both ends, hidden behind center wall -->
    <include><name>stop_sign_reappear</name><uri>model://stop_sign</uri><pose>6 17 0 0 0 0.000000</pose></include>
    <!-- B: separates two signs, only 2 m apart -->
    <model name="separator_wall">
      <static>true</static>
      <pose>11 8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>7.5 0.45 3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>7.5 0.45 3</size></box></geometry>
          <material><ambient>0.58 0.60 0.64 1</ambient><diffuse>0.58 0.60 0.64 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- C: hides center sightline, ends open -->
    <model name="occlusion_wall">
      <static>true</static>
      <pose>6 15.2 1.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.8 0.5 3.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.8 0.5 3.2</size></box></geometry>
          <material><ambient>0.58 0.60 0.64 1</ambient><diffuse>0.58 0.60 0.64 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Scenery away from test sightlines -->
    <include><name>background_pine</name><uri>model://pine_tree</uri><pose>4 -7.5 0 0 0 0.700000</pose></include>
    <!-- Scenery away from test sightlines -->
    <include><name>background_oak</name><uri>model://oak_tree</uri><pose>17.5 17 0 0 0 0.200000</pose></include>
  </world>
</sdf>
